# Copy to .env for the IDX/IHSG edition. Keep credentials out of Git.
STOCK_LIST=BBCA.JK,TLKM.JK,ASII.JK
MARKET_REVIEW_REGION=id
REPORT_LANGUAGE=en
SCHEDULE_ENABLED=false

# Choose a supported provider/model and supply your own key for AI analysis.
# See .env.example for complete provider configuration. No key is included.
GENERATION_BACKEND=litellm
LITELLM_MODELS=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Trusted local use only. The Android beta does not implement browser login.
WEBUI_ENABLED=true
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8000
ADMIN_AUTH_ENABLED=false
